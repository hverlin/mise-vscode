				}
			}
		},
		{
			"name": "meta.array.run.toml",
			"begin": "(?<![\\w-])((?:(?:[A-Za-z0-9_-]+|\"[^\"]*\"|'[^']*')\\s*\\.\\s*)*run)\\s*(=)\\s*(\\[)",
			"beginCaptures": {
				"1": {
					"name": "variable.other.key.toml"
				},
				"2": {
					"name": "keyword.operator.assignment.toml"
				},
				"3": {
					"name": "punctuation.definition.array.begin.toml"
				}
			},
			"end": "\\]",
			"endCaptures": {
				"0": {
					"name": "punctuation.definition.array.end.toml"
				}
			},
			"patterns": [
				{
					"match": "(#).*$",
					"name": "comment.line.number-sign.toml",
					"captures": {
						"1": {
							"name": "punctuation.definition.comment.toml"
						}
					}
				},
				{
					"begin": "(\"\"\")",
					"beginCaptures": {
						"1": {
							"name": "string.quoted.triple.basic.run.block.toml punctuation.definition.string.begin.toml"
						}
					},
					"end": "\"\"\"(?!\")",
					"endCaptures": {
						"0": {
							"name": "string.quoted.triple.basic.run.block.toml punctuation.definition.string.end.toml"
						}
					},
					"contentName": "string.quoted.triple.basic.run.block.toml",
					"patterns": [
						{
							"match": "\\\\([btnfr\"\\\\\\n/ ]|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8})",
							"name": "constant.character.escape.toml"
						},
						{
							"match": "\\\\[^btnfr/\"\\\\\\n]",
							"name": "invalid.illegal.escape.toml"
						},
						{
							"include": "source.mise.shell"
						}
					]
				},
				{
					"begin": "(''')",
					"beginCaptures": {
						"1": {
							"name": "string.quoted.triple.literal.run.block.toml punctuation.definition.string.begin.toml"
						}
					},
					"end": "'''(?!')",
					"endCaptures": {
						"0": {
							"name": "string.quoted.triple.literal.run.block.toml punctuation.definition.string.end.toml"
						}
					},
					"contentName": "string.quoted.triple.literal.run.block.toml",
					"patterns": [
