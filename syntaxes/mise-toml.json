		},
		{
			"match": "(?<![\\w-])((?:(?:[A-Za-z0-9_-]+|\"[^\"]*\"|'[^']*')\\s*\\.\\s*)*run)\\s*(=)\\s*(')([^']*)(')",
			"captures": {
				"1": {
					"name": "variable.other.key.toml"
				},
				"2": {
					"name": "keyword.operator.assignment.toml"
				},
				"3": {
					"name": "string.quoted.single.literal.line.run.toml punctuation.definition.string.begin.toml"
				},
				"4": {
					"name": "string.quoted.single.literal.line.run.toml",
