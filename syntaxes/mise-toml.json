			"captures": {
				"1": {
					"name": "variable.other.key.toml"
				},
				"2": {
					"name": "keyword.operator.assignment.toml"
				},
				"3": {
					"name": "string.quoted.single.basic.line.run.toml punctuation.definition.string.begin.toml"
				},
				"4": {
					"name": "string.quoted.single.basic.line.run.toml",
					"patterns": [
						{
							"match": "\\\\([btnfr\"\\\\\\n/ ]|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8})",
							"name": "constant.character.escape.toml"
						},
						{
