		{
			"begin": "(?<![\\w-])((?:(?:[A-Za-z0-9_-]+|\"[^\"]*\"|'[^']*')\\s*\\.\\s*)*usage)\\s*(=)\\s*(''')",
			"beginCaptures": {
				"1": {
					"name": "variable.other.key.toml"
				},
				"2": {
					"name": "keyword.operator.assignment.toml"
				},
				"3": {
					"name": "string.quoted.triple.literal.usage.block.toml punctuation.definition.string.begin.toml"
				}
			},
			"end": "'''(?!')",
			"endCaptures": {
				"0": {
