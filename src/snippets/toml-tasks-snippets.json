{
	"tomlTask": {
		"prefix": "mise-task",
		"description": "Create a new mise task with common options",
		"body": [
			"[tasks.${1:my_toml_task}]",
			"${2:description = '${3:Task description}'\n}${4:depends = [${5:'dependency'}]\n}run = \"echo 'running...'\"",
			"$0"
		]
	},
	"tomlTaskArray": {
		"prefix": "mise-task-array",
		"description": "Create a mise task with multiple commands",
		"body": [
			"[tasks.${1:my_task}]",
			"${2:description = '${3:Task description}'\n}${4:depends = [${5:'dependency'}]\n}run = [",
			"    \"echo 'running step 1...'\",",
			"    \"echo 'running step 2...'\"",
			"]",
			"$0"
		]
	},
	"tomlTaskScript": {
		"prefix": "mise-task-script",
		"description": "Create a mise task with multiline script",
		"body": [
			"[tasks.${1:my_script_task}]",
			"${2:description = '${3:Task description}'\n}run = '''",
			"#!/usr/bin/env ${4|bash,python,node,bun,-S deno run,ruby,-S uv run --script|}",
			"",
			"${5:# your script here}",
			"'''",
			"$0"
		]
	},
	"tomlTaskUsage": {
		"prefix": "mise-task-usage",
		"description": "Create a mise task with arguments defined with the usage spec",
		"body": [
			"[tasks.${1:my_task}]",
			"${2:description = '${3:Task description}'\n}usage = '''",
			"arg \"<${4:file}>\" help=\"${5:File to use}\"",
			"flag \"-v --verbose\" help=\"Enable verbose output\"",
			"'''",
			"run = 'echo \"\\${usage_$4?}\"'",
			"$0"
		]
	},
	"tomlTaskTemplate": {
		"prefix": "mise-task-template",
		"description": "Create a reusable task template that tasks can extend",
		"body": [
			"[task_templates.${1:my:template}]",
			"${2:description = '${3:Template description}'\n}${4:tools = { ${5:node} = \"${6:latest}\" }\n}run = \"echo 'running...'\"",
			"$0"
		]
	},
	"nodeTask": {
		"prefix": "mise-task-node",
		"description": "Create a mise task with nodejs",
		"body": [
			"[tasks.${1:my_node_task}]",
			"${2:description = '${3:Task description}'\n}run = '''",
			"#!/usr/bin/env node",
			"",
			"${4:console.log('running...')}",
			"'''",
			"$0"
		]
	},
	"pythonTask": {
		"prefix": "mise-task-python",
		"description": "Create a mise task with python",
		"body": [
			"[tasks.${1:my_python_task}]",
			"${2:description = '${3:Task description}'\n}run = '''",
			"#!/usr/bin/env python",
			"",
			"${4:print('running...')}",
			"'''",
			"$0"
		]
	},
	"uvTask": {
		"prefix": "mise-task-uv",
		"description": "Create a mise task with uv",
		"body": [
			"[tasks.${1:my_uv_task}]",
			"${2:description = '${3:Task description}'\n}run = '''",
			"#!/usr/bin/env uv run --script",
			"# /// script\n# dependencies = [\"requests\"]\n# ///",
			"",
			"${4:import requests\nresp = requests.get(\"https://peps.python.org/api/peps.json\")\ndata = resp.json()\nprint(data)}",
			"'''",
			"$0"
		]
	},
	"denoTask": {
		"prefix": "mise-task-deno",
		"description": "Create a mise task with deno",
		"body": [
			"[tasks.${1:my_deno_task}]",
			"${2:description = '${3:Task description}'\n}run = '''",
			"#!/usr/bin/env -S deno run",
			"",
			"${4:console.log('running...')}",
			"'''",
			"$0"
		]
	},
	"bunTask": {
		"prefix": "mise-task-bun",
		"description": "Create a mise task with bun",
		"body": [
			"[tasks.${1:my_bun_task}]",
			"${2:description = '${3:Task description}'\n}run = '''",
			"#!/usr/bin/env bun",
			"",
			"${4:import { $ \\} from \"bun\";\nawait $`echo 'running...'`}",
			"'''",
			"$0"
		]
	},
	"rubyTask": {
		"prefix": "mise-task-ruby",
		"description": "Create a mise task with ruby",
		"body": [
			"[tasks.${1:my_ruby_task}]",
			"${2:description = '${3:Task description}'\n}run = '''",
			"#!/usr/bin/env ruby",
			"",
			"${4:puts 'running...'}",
			"'''",
			"$0"
		]
	},
	"tomlTaskFull": {
		"prefix": "mise-task-full",
		"description": "Create a mise task with all possible options",
		"body": [
			"[tasks.${1:task_with_all_options}]",
			"description = '${2:Task description}'",
			"depends = [${3:'dependency'}]",
			"alias = '${4:shortname}'",
			"dir = '${5:{{cwd}}}'",
			"env = {${6:KEY = 'value'}}",
			"hide = ${7|true,false|}",
			"sources = [${8:'src/**/*'}]",
			"outputs = [${9:'dist/**/*'}]",
			"shell = '${10:bash -c}'",
			"usage = '''",
			"arg \"<${11:file}>\" help=\"${12:File to use}\"",
			"'''",
			"run = '''",
			"echo 'running step 1...'",
			"echo \"running step 2 with \\${usage_${11}?}\"",
			"'''",
			"$0"
		]
	}
}
