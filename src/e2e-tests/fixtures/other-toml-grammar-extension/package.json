{
	"name": "other-toml-grammar",
	"displayName": "Another TOML grammar (e2e tests)",
	"description": "Contributes Tombi's TOML grammar after mise-vscode, as when Tombi or Even Better TOML wins the extension load order",
	"publisher": "mise-vscode-tests",
	"version": "0.0.1",
	"license": "MIT",
	"engines": { "vscode": "^1.85.0" },
	"contributes": {
		"languages": [{ "id": "toml", "extensions": [".toml"] }],
		"grammars": [
			{
				"language": "toml",
				"scopeName": "source.toml",
				"path": "./toml.tmLanguage.json"
			}
		]
	}
}
