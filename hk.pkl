amends "package://github.com/jdx/hk/releases/download/v2.5.0/hk@2.5.0#/Config.pkl"

min_hk_version = "2.5.0"

local linters = new Mapping<String, Step> {
  ["tsc"] {
    check = "tsc --noEmit"
    glob = List("*.js", "*.ts")
  }
  ["biome"] {
    fix = "biome check --fix"
    check = "biome check"
    glob = List("*.js", "*.ts", "*.json")
  }
}

// Defines the check, fix, and pre-commit hooks.
steps = linters

hooks {
  ["pre-push"] {
    steps = linters
  }
}
